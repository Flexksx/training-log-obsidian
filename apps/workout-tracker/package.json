    "svelte": "catalog:",
    "workout": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "esbuild": "^0.28.2",
    "esbuild-svelte": "^0.9.5",
    "eslint": "catalog:",
    "eslint-plugin-svelte": "catalog:",
    "obsidian": "^1.14.4",
    "svelte-check": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
