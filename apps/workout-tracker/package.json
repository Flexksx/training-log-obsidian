{
  "name": "workout-tracker",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "lint": "biome ci && eslint && svelte-check --fail-on-warnings",
    "format": "biome check --write && eslint --fix"
  },
  "dependencies": {
    "activity": "workspace:*",
