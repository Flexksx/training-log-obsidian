{
  "name": "workout-tracker",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "lint": "biome ci && eslint && svelte-check --fail-on-warnings",
    "format": "biome check --write && eslint --fix"
  },
  "dependencies": {
    "activity": "workspace:*",
    "svelte": "^5.57.2",
    "workout": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "esbuild": "^0.28.2",
    "esbuild-svelte": "^0.9.5",
    "eslint": "^10.13.0",
    "eslint-plugin-svelte": "^3.23.1",
    "obsidian": "^1.14.4",
    "svelte-check": "^4.7.7",
    "typescript": "catalog:",
    "typescript-eslint": "^8.72.0"
  }
}
